# Organization Ranking
taiwan_org_rank <- function(){
  url = "https://www.fangraphs.com/prospects/the-board/2025-in-season-prospect-list?sortcol=13&sortdir=desc&search=taiwan"
  webpage <- read_html(url)
  
  tables <- webpage %>%
    html_elements("table") %>%
    html_table()
  
  return(tables[[9]])
}

taiwan_org_rank <- taiwan_org_rank() %>% 
  mutate(full_name = str_squish(NameName)) %>% 
  rename(org_rank = `Org RkRank withinteam's farm system`) %>% 
