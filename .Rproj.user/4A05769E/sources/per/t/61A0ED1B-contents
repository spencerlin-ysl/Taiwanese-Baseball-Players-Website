                     limits = c(-2.5, 2.5)) + 
  scale_y_continuous("Vertical location(ft.)") + 
  theme_classic() + 
  guides(color = guide_legend_interactive(title = "Pitch Type", override.aes = list(size = 3)))



k_zone_plot = girafe(ggobj = k_zone_plot)
